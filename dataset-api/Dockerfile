FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_HTTP_TIMEOUT=120 \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

ARG R2_BUCKET
ARG R2_ENDPOINT_URL
ARG R2_ACCESS_KEY_ID
ARG R2_SECRET_ACCESS_KEY
ARG PDF_PREFIX
ARG PUBLIC_BASE_URL
ARG TURSO_DATABASE_URL
ARG TURSO_AUTH_TOKEN
ARG SYNC_ON_STARTUP=true
ARG PARSE_ON_STARTUP=true
ARG STARTUP_BATCH_SIZE=10
ARG HTTP_TIMEOUT=30
ARG PORT=8000
ARG UNSTRUCTURED_API_URL=https://platform-api.transform.unstructured.io/api/v1
ARG UNSTRUCTURED_API_KEY
ARG UNSTRUCTURED_POLL_SECONDS=10
ARG UNSTRUCTURED_PARTITION_STRATEGY=fast

ENV R2_BUCKET=$R2_BUCKET \
    R2_ENDPOINT_URL=$R2_ENDPOINT_URL \
    R2_ACCESS_KEY_ID=$R2_ACCESS_KEY_ID \
    R2_SECRET_ACCESS_KEY=$R2_SECRET_ACCESS_KEY \
    PDF_PREFIX=$PDF_PREFIX \
    PUBLIC_BASE_URL=$PUBLIC_BASE_URL \
    TURSO_DATABASE_URL=$TURSO_DATABASE_URL \
    TURSO_AUTH_TOKEN=$TURSO_AUTH_TOKEN \
    SYNC_ON_STARTUP=$SYNC_ON_STARTUP \
    PARSE_ON_STARTUP=$PARSE_ON_STARTUP \
    STARTUP_BATCH_SIZE=$STARTUP_BATCH_SIZE \
    HTTP_TIMEOUT=$HTTP_TIMEOUT \
    PORT=$PORT \
    UNSTRUCTURED_API_URL=$UNSTRUCTURED_API_URL \
    UNSTRUCTURED_API_KEY=$UNSTRUCTURED_API_KEY \
    UNSTRUCTURED_POLL_SECONDS=$UNSTRUCTURED_POLL_SECONDS \
    UNSTRUCTURED_PARTITION_STRATEGY=$UNSTRUCTURED_PARTITION_STRATEGY

COPY --from=ghcr.io/astral-sh/uv:0.8.14 /uv /uvx /bin/
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY . .

EXPOSE 8000
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"]
